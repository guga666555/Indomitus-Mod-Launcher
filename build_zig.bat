@echo off
REM Builds "Indomitus Launcher.exe" with zig (clang + mingw-w64 bundled). Needs no Visual Studio
REM and no Python: if zig is not found it downloads the portable zig 0.14.0 zip from ziglang.org
REM (about 80 MB, once) into the zig\ folder next to this file. Everything is logged to build_zig.log.
REM
REM   build_zig.bat        -> release build: ONLY the files in launcher\payload\ can ever be injected
REM   build_zig.bat dev    -> dev build: also loads dlls\*.dll next to the exe, tagged DEV in the window

REM Re-launch inside a console window that stays open no matter what happens.
if "%~1"=="__inner" goto :inner
start "Indomitus Launcher build" cmd /k ""%~f0" __inner %~1"
exit /b

:inner
set "MODE=%~2"
cd /d "%~dp0"
set "LOG=%~dp0build_zig.log"
echo build started %date% %time% (mode: %MODE%) > "%LOG%"
echo.
echo === Indomitus Launcher build (%MODE%) ===
echo folder: %~dp0

set "ZIG_URL=https://ziglang.org/download/0.14.0/zig-windows-x86_64-0.14.0.zip"
set "ZIGCMD="

REM ---- 1. portable zig next to this script
if exist "%~dp0zig\zig.exe" set ZIGCMD="%~dp0zig\zig.exe"
if defined ZIGCMD goto :have_zig

REM ---- 2. zig on PATH
where zig >nul 2>&1
if not errorlevel 1 set ZIGCMD=zig
if defined ZIGCMD goto :have_zig

REM ---- 3. ziglang inside a Python
python -m ziglang version >nul 2>&1
if not errorlevel 1 set ZIGCMD=python -m ziglang
if defined ZIGCMD goto :have_zig
py -m ziglang version >nul 2>&1
if not errorlevel 1 set ZIGCMD=py -m ziglang
if defined ZIGCMD goto :have_zig

REM ---- 4. download the portable zip
echo zig was not found. Downloading portable zig 0.14.0 - about 80 MB, one time only...
echo   %ZIG_URL%
echo step: downloading %ZIG_URL% >> "%LOG%"
curl -L --fail --progress-bar -o "%TEMP%\zig_portable.zip" "%ZIG_URL%" 2>>"%LOG%"
if errorlevel 1 goto :download_failed
echo extracting...
echo step: extracting >> "%LOG%"
if exist "%~dp0zig_tmp" rmdir /s /q "%~dp0zig_tmp"
mkdir "%~dp0zig_tmp"
tar -xf "%TEMP%\zig_portable.zip" -C "%~dp0zig_tmp" 2>>"%LOG%"
if errorlevel 1 goto :extract_failed
del "%TEMP%\zig_portable.zip" >nul 2>&1
for /d %%D in ("%~dp0zig_tmp\*") do if exist "%%D\zig.exe" move "%%D" "%~dp0zig" >nul
rmdir /s /q "%~dp0zig_tmp" >nul 2>&1
if not exist "%~dp0zig\zig.exe" goto :extract_failed
set ZIGCMD="%~dp0zig\zig.exe"

:have_zig
echo step: using %ZIGCMD% >> "%LOG%"
echo using: %ZIGCMD%
%ZIGCMD% version 2>>"%LOG%"

if not exist dist mkdir dist

REM ---- embedded payload: only *.dll and *.ini in launcher\payload\ (no hidden/system files, no .lib/.pdb/copies of
REM      other types). Every embedded .dll is injected, so keep exactly the DLLs you ship in that folder.
echo // generated by build_zig.bat> launcher\payload.rc
type nul > launcher\payload.manifest
set /a PID=500
set /a PAYLOAD_COUNT=0
set "PAYLOAD_BAD="
if not exist launcher\payload mkdir launcher\payload
for /f "delims=" %%F in ('dir /b /a-d-h-s /on launcher\payload\*.dll launcher\payload\*.ini 2^>nul') do call :add_payload "%%F"
if defined PAYLOAD_BAD goto :payload_failed
echo 500 RCDATA "payload.manifest">> launcher\payload.rc
echo payload: %PAYLOAD_COUNT% file(s) embedded
echo payload: %PAYLOAD_COUNT% file(s) >> "%LOG%"
if "%MODE%"=="dev" goto :payload_ok
if "%PAYLOAD_COUNT%"=="0" goto :no_payload
:payload_ok

REM ---- optional embedded title font: launcher\res\title.ttf
echo // generated by build_zig.bat> launcher\fonts.rc
if exist launcher\res\title.ttf echo 400 RCDATA "res\\title.ttf">> launcher\fonts.rc
if exist launcher\res\title.ttf echo embedding title font launcher\res\title.ttf

REM ---- auto-update signing key: tools\update_sign.exe keeps the PRIVATE key outside this folder
REM      (%USERPROFILE%\.indomitus\update_signing.key, created on the first build - BACK IT UP) and writes the
REM      public half to launcher\update_pubkey.h, which is compiled in. Without it updates stay disabled.
echo step: update signing tool >> "%LOG%"
%ZIGCMD% cc -target x86_64-windows-gnu -O2 tools\update_sign.c -o tools\update_sign.exe -lbcrypt 2>>"%LOG%"
if errorlevel 1 echo   ! could not build tools\update_sign.exe - this launcher will not be able to auto-update
if exist tools\update_sign.exe tools\update_sign.exe pubheader launcher\update_pubkey.h
if errorlevel 1 echo   ! update key not available - this launcher will not be able to auto-update
REM ---- settings: launcher\settings.gen.ini (a copy of gem_launcher.ini) is what gets compiled in. version= in it is
REM      THE version (window, caption, exe, update.ini); a warning appears if it is not above the newest git tag.
if exist launcher\settings.gen.ini del launcher\settings.gen.ini
if exist tools\update_sign.exe tools\update_sign.exe stamp gem_launcher.ini .git launcher\settings.gen.ini
if not exist launcher\settings.gen.ini copy /y gem_launcher.ini launcher\settings.gen.ini >nul

REM ---- exe version info (Explorer > Properties) from the same version
if exist launcher\version.rc del launcher\version.rc
if exist tools\update_sign.exe tools\update_sign.exe versionrc launcher\settings.gen.ini launcher\version.rc
if not exist launcher\version.rc echo // no version info: tools\update_sign.exe was not available> launcher\version.rc
del tools\update_sign.pdb tools\update_sign.lib >nul 2>&1

set CXX=%ZIGCMD% c++ -target x86_64-windows-gnu -O2 -std=c++17 -DUNICODE -D_UNICODE
set "OUT=Indomitus Launcher.exe"
if "%MODE%"=="dev" set CXX=%CXX% -DDEV_BUILD
if "%MODE%"=="dev" set "OUT=Indomitus Launcher DEV.exe"
set LIBS=-lshlwapi -lpsapi -lshell32 -ladvapi32 -luser32 -lgdi32 -lmsimg32 -lcomctl32 -lwinmm -lbcrypt -lwinhttp -lkernel32

echo.
echo [1/1] %OUT%
echo step: compiling launcher >> "%LOG%"
if exist "dist\%OUT%" del "dist\%OUT%"
%CXX% -s -static -Wl,--subsystem,windows launcher\main.cpp launcher\launcher.rc -o "dist\%OUT%" %LIBS% 2>>"%LOG%"
if errorlevel 1 goto :compile_failed

del dist\*.lib >nul 2>&1
if exist "dist\GEM Launcher.exe" del "dist\GEM Launcher.exe"
if "%MODE%"=="" if exist dist\gem_launcher.ini del dist\gem_launcher.ini
if "%MODE%"=="dev" copy /y launcher\settings.gen.ini dist\gem_launcher.ini >nul
if "%MODE%"=="" call :release_files
if "%MODE%"=="dev" if not exist dist\dlls mkdir dist\dlls
echo.
echo Done. Files in %~dp0dist :
dir /b dist
echo build ok >> "%LOG%"
goto :eof

REM ---------------------------------------------------------------- subroutines / errors

:add_payload
set /a PID+=1
set /a PAYLOAD_COUNT+=1
set "PF=%~1"
set "PH="
for /f "skip=1 delims=" %%H in ('certutil -hashfile "launcher\payload\%PF%" SHA256') do if not defined PH set "PH=%%H"
set "PH=%PH: =%"
REM a SHA-256 is exactly 64 hex digits; anything else is a certutil error message (file locked, etc.)
if "%PH:~63,1%"=="" set "PAYLOAD_BAD=%PF%"
if not "%PH:~64,1%"=="" set "PAYLOAD_BAD=%PF%"
echo %PH%| findstr /r /x "[0-9a-fA-F]*" >nul || set "PAYLOAD_BAD=%PF%"
if defined PAYLOAD_BAD goto :eof
echo %PID% RCDATA "payload\\%PF%">> launcher\payload.rc
echo %PID%^|%PF%^|%PH%>> launcher\payload.manifest
echo   + %PF%  [%PH:~0,12%]
goto :eof

:release_files
REM ---- dist\release\ = what you upload for the auto-updater: Indomitus.exe + update.ini (signed manifest).
REM      update.ini is only written when update_exe_url= is set in gem_launcher.ini.
if not exist dist\release mkdir dist\release
if exist dist\release\update.ini del dist\release\update.ini
if exist dist\release\Indomitus.exe del dist\release\Indomitus.exe
if exist dist\release\Indomitus.exe goto :release_locked
copy /y "dist\%OUT%" dist\release\Indomitus.exe >nul
if not exist dist\release\Indomitus.exe goto :release_locked
if not exist tools\update_sign.exe echo   ! tools\update_sign.exe is missing - update.ini was NOT written
if not exist tools\update_sign.exe goto :eof
tools\update_sign.exe sign dist\release\Indomitus.exe launcher\settings.gen.ini dist\release\update.ini launcher\update_pubkey.h
if errorlevel 1 echo   ! update.ini was NOT written - see the message above
goto :eof

:release_locked
echo   ! dist\release\Indomitus.exe is locked by another program - close it; nothing in dist\release was updated
echo release files locked >> "%LOG%"
goto :eof

:payload_failed
echo.
echo   *** could not hash launcher\payload\%PAYLOAD_BAD% - is it open in another program?
echo       Nothing was built. Close it and run this again.
echo payload hash failed: %PAYLOAD_BAD% >> "%LOG%"
goto :eof

:no_payload
echo.
echo   *** launcher\payload\ is empty. A release build must carry the engine extension:
echo       copy gem_breedtags.dll (the BreedTags dbghelp.dll, renamed) and gem_breedtags.ini there.
echo       For a build that loads DLLs from dlls\ instead, run:   build_zig.bat dev
echo no payload >> "%LOG%"
goto :eof

:download_failed
echo.
echo   *** download failed. Check your connection, or download the zip yourself from
echo       %ZIG_URL%
echo       and extract it so that  %~dp0zig\zig.exe  exists, then run this again.
echo download failed >> "%LOG%"
type "%LOG%"
goto :eof

:extract_failed
echo.
echo   *** extracting the zig zip failed - details in build_zig.log ***
echo extract failed >> "%LOG%"
type "%LOG%"
goto :eof

:compile_failed
echo.
echo   *** compile FAILED - details below and in build_zig.log ***
echo compile failed >> "%LOG%"
type "%LOG%"
goto :eof
