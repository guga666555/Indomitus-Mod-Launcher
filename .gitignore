# ---- signing keys: NEVER commit (the real one lives in %USERPROFILE%\.indomitus\, outside this folder)
*.key

# ---- toolchain: downloaded by build_zig.bat, and zig.exe is over GitHub's 100 MB file limit
zig/
**/zig/

# ---- build output, logs, intermediates
dist/
**/dist/
*.log
*.lib
*.pdb
*.obj
*.exe
__pycache__/

# compiled DLLs anywhere except the payload the launcher embeds (keeps the repo buildable)
*.dll
!launcher/payload/*.dll

# ---- regenerated by build_zig.bat on every build
launcher/payload.rc
launcher/payload.manifest
launcher/fonts.rc
launcher/version.rc
launcher/settings.gen.ini

# ---- local backups, private notes, study material (game files and other people's DLLs)
_bckps/
**/_bckp/
**/_for_claude_to_study/
reminding me.txt
