// Resources of Indomitus.exe. Compiled by zig's rc; ids must match the enums in main.cpp.

// Icon 1 is what Explorer shows for the exe (tools\make_icon.py turns any PNG/JPG into a multi-size .ico).
1 ICON "icon.ico"

// Button sounds, compiled into the exe (ids must match RES_SOUND_* in main.cpp).
201 WAVE "res\\hover.wav"
202 WAVE "res\\click.wav"

// Background plate, stretched to the window.
300 BITMAP "res\\background.bmp"

// Title logo (32-bit BMP with premultiplied alpha, made by tools\make_logo.py). Remove this line
// to fall back to the text title in the embedded font.
310 BITMAP "res\\logo.bmp"

// Title font: fonts.rc is (re)generated by the build script and adds
//   400 RCDATA "res\\title.ttf"
// when launcher\res\title.ttf exists. Without it the title falls back to Impact.
#include "fonts.rc"

// Sealed payload (generated by the build script from launcher\payload\*):
//   500 RCDATA payload.manifest, 501.. RCDATA the files themselves.
#include "payload.rc"

// Launcher settings: gem_launcher.ini with version= set from the newest git tag (build_zig.bat writes this copy).
600 RCDATA "settings.gen.ini"

// UI languages (UTF-8 key=text files; ids must match kLangs[] in main.cpp).
700 RCDATA "lang\\en.ini"
701 RCDATA "lang\\de.ini"
702 RCDATA "lang\\pt.ini"
703 RCDATA "lang\\es.ini"
704 RCDATA "lang\\zh.ini"
705 RCDATA "lang\\ru.ini"
706 RCDATA "lang\\uk.ini"
707 RCDATA "lang\\pl.ini"
708 RCDATA "lang\\it.ini"
709 RCDATA "lang\\fr.ini"
710 RCDATA "lang\\nl.ini"
711 RCDATA "lang\\hi.ini"
712 RCDATA "lang\\ar.ini"

// Version info (Explorer > Properties > Details): generated by build_zig.bat from version= in gem_launcher.ini.
#include "version.rc"

// Tell Windows this is a modern, DPI-aware app that does not need UAC elevation.
1 24 "launcher.manifest"
