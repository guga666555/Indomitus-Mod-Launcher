+    const char *pFaunaIcon[] = { "fauna_main", "fauna_size05", "icon_carnifex" };
+    const char *pFaunaNone[] = { "fauna_main", "fauna_size02" };
+    const char *pTankIcon[]  = { "tank", "board_astartes", "icon_sm_cannon", "squad_icon_cannon" };
+    const char *pTankNone[]  = { "tank", "board_astartes", "heavy" };
+    const char *pHumanIcon[] = { "icon_should_not_matter" };
+    const char *pIconOnly[]  = { "icon_" };                      /* prefix alone: not a name */
+    const char *pCannonIcon[] = { "cannon", "icon_my_gun" };
+    FakeDef *dFI = make_def(pFaunaIcon, 3), *dFN = make_def(pFaunaNone, 2), *dTI = make_def(pTankIcon, 4),
+            *dTN = make_def(pTankNone, 3), *dHI = make_def(pHumanIcon, 1), *dIO = make_def(pIconOnly, 1),
+            *dCI = make_def(pCannonIcon, 2), *dNone = make_def(NULL, 0);
+    /* flags: 2 alive / in scene, 4 human, 8 vehicle class */
+    FakeEnt *fauna = make_ent(dFI, 2 | 8), *faunaNo = make_ent(dFN, 2 | 8), *tank = make_ent(dTI, 2 | 8),
+            *tank2 = make_ent(dTI, 2 | 8), *tankNo = make_ent(dTN, 2 | 8), *human = make_ent(dHI, 2 | 4),
+            *iconOnly = make_ent(dIO, 2 | 8), *cannon = make_ent(dCI, 2 | 8), *noProps = make_ent(dNone, 2 | 8),
+            *deadTank = make_ent(dTI, 8), *noDef = make_ent(NULL, 2 | 8);
+#ifdef EXPECT_0121
+    const char *veh = "0.12.1 (fauna only)";
+    const char *tankWant = "/interface/scene/squad/icon_tank(sm)", *cannonWant = "/interface/scene/squad/icon_cannon(sm)";
+#else
+    const char *veh = "0.12.2 (any non-human)";
+    const char *tankWant = "/interface/scene/squad/icon_sm_cannon", *cannonWant = "/interface/scene/squad/icon_my_gun";
+#endif
+    printf("headicon gate test, expectations of %s, source " FX_HEADICON_SRC "\n", veh);
+    check("fauna + icon_carnifex", fauna, 0, "icon_vehicle", "/interface/scene/squad/icon_carnifex");
+    check("fauna, no icon_ prop", faunaNo, 0, "icon_vehicle", "/interface/scene/squad/icon_vehicle(sm)");
+    check("tank + icon_sm_cannon", tank, 0, "icon_tank", tankWant);
+    check("tank + icon_sm_cannon (second unit, same def: cache)", tank2, 0, "icon_tank", tankWant);
+    check("tank + icon_sm_cannon again (cache hit)", tank, 0, "icon_tank", tankWant);
+    check("cannon + icon_my_gun", cannon, 0, "icon_cannon", cannonWant);
+    check("tank, no icon_ prop", tankNo, 0, "icon_tank", "/interface/scene/squad/icon_tank(sm)");
+    check("tank, no icon_ prop again (cached no)", tankNo, 0, "icon_tank", "/interface/scene/squad/icon_tank(sm)");
+    check("vehicle with no props at all", noProps, 0, "icon_vehicle", "/interface/scene/squad/icon_vehicle(sm)");
+    check("prop \"icon_\" alone (no name)", iconOnly, 0, "icon_vehicle", "/interface/scene/squad/icon_vehicle(sm)");
+    check("human whose def has an icon_ prop", human, 0, "icon_stub", "/interface/scene/squad/icon_stub(sm)");
+    check("tank + icon_ prop, not alive / in scene (flag 2 off)", deadTank, 0, "icon_tank", "/interface/scene/squad/icon_tank(sm)");
+    check("vehicle without a def", noDef, 0, "icon_vehicle", "/interface/scene/squad/icon_vehicle(sm)");
+    check("tank + icon_ prop, spectator name", tank, 1, "icon_tank", "/interface/scene/squad/spectator_enemy");
+    check("fauna + icon_ prop, spectator name", fauna, 1, "icon_vehicle", "/interface/scene/squad/spectator_enemy");
+    check("no entity", NULL, 0, "icon_stub", "/interface/scene/squad/icon_stub(sm)");
+    /* two defs on the same cache slot (64 entries, (def >> 4) % 64): the answer follows the def, not the slot */
+    FakeDef *a = NULL, *b = NULL;
+    for (int i = 0; i < 4000 && !b; i++) {
+        FakeDef *d = make_def(i & 1 ? pTankNone : pTankIcon, i & 1 ? 3 : 4);
+        if (!(i & 1) && !a) { a = d; continue; }
+        if (a && (i & 1) && (((uintptr_t)d >> 4) % 64) == (((uintptr_t)a >> 4) % 64)) b = d;
+    }
+    if (a && b) {
+        FakeEnt *ea = make_ent(a, 2 | 8), *eb = make_ent(b, 2 | 8);
+        check("slot collision: def A (icon_)", ea, 0, "icon_tank", tankWant);
+        check("slot collision: def B (none), same slot", eb, 0, "icon_tank", "/interface/scene/squad/icon_tank(sm)");
+        check("slot collision: def A again", ea, 0, "icon_tank", tankWant);
+    } else printf("  (no colliding def pair found: slot collision case skipped)\n");
+    printf("%d checks, %d failed: %s\n", g_n, g_fail, g_fail ? "FAILED" : "ALL OK");
+    return g_fail != 0;
+}
diff --git a/_dlls/_indomitus_DLL_fauna/tests/run_offline_check_win.py b/_dlls/_indomitus_DLL_fauna/tests/run_offline_check_win.py
new file mode 100644
index 0000000..9349761
--- /dev/null
+++ b/_dlls/_indomitus_DLL_fauna/tests/run_offline_check_win.py
@@ -0,0 +1,81 @@
+"""Windows counterpart of tests/run_offline_check.sh (no Linux / WSL needed), with zig cc:
+  1. build dist\\gem_fauna.dll exactly as build.bat does (+ gem_fauna.ini), and once more with -Werror
+  2. fx_test.exe (FX_TEST build; tests\\win\\sys\\mman.h maps each exe at its image base with VirtualAlloc, the test exe
+     itself is linked at another base) run against every exe given -> every finder, incl. "head icon finders"
+  3. tests\\headicon_gate_test.c against this source (0.12.2 expectations) and, if given, against an older source
+     folder with -DEXPECT_0121
+usage: python -B tests\\run_offline_check_win.py <zig.exe> <old source dir or -> <exe> [<exe> ...]
+Output goes to stdout; the caller keeps it (out\\test_output.txt).
+"""
+import os
+import subprocess
+import sys
+
+HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+WARN = ["-Wall", "-Wextra", "-Wno-unused-parameter", "-Wno-missing-field-initializers"]
+
+
+def run(args, cwd=HERE):
+    r = subprocess.run(args, cwd=cwd, capture_output=True)
+    text = (r.stdout + r.stderr).decode("utf-8", "replace")
+    return r.returncode, text
+
+
+def main():
+    zig, old, exes = sys.argv[1], sys.argv[2], sys.argv[3:]
+    ok = True
+    os.makedirs(os.path.join(HERE, "dist"), exist_ok=True)
+    os.makedirs(os.path.join(HERE, "out"), exist_ok=True)
+    print("=== 1. dll build (build.bat flags)")
+    rc, t = run([zig, "cc", "-target", "x86_64-windows-gnu", "-O2", "-s", "-shared"] + WARN +
+                ["-o", r"dist\gem_fauna.dll", r"src\gem_fauna.c", "-lkernel32", "-luser32"])
+    print("exit", rc, "| compiler output:", t.strip() or "none (no warnings)")
+    ok &= rc == 0
+    for f in os.listdir(os.path.join(HERE, "dist")):
+        if f.endswith((".lib", ".pdb")):
+            os.remove(os.path.join(HERE, "dist", f))
+    ini = open(os.path.join(HERE, "gem_fauna.ini"), "rb").read()
+    with open(os.path.join(HERE, "dist", "gem_fauna.ini.tmp"), "wb") as f:
+        f.write(ini)
+    os.replace(os.path.join(HERE, "dist", "gem_fauna.ini.tmp"), os.path.join(HERE, "dist", "gem_fauna.ini"))
+    rc, t = run([zig, "cc", "-target", "x86_64-windows-gnu", "-O2", "-shared"] + WARN + ["-Werror", "-o", r"out\werror_check.dll", r"src\gem_fauna.c", "-lkernel32", "-luser32"])
+    print("-Werror build: exit", rc, t.strip() or "(no warnings)")
+    ok &= rc == 0
+
+    print("=== 2. finder check (FX_TEST)")
+    fx = os.path.join(HERE, "out", "fx_test.exe")
+    rc, t = run([zig, "cc", "-target", "x86_64-windows-gnu", "-O1", "-DFX_TEST", "-I", r"tests\win", "-Wall", "-Wextra",
+                 "-Wno-unused-parameter", "-Wno-unused-function", "-Wno-unused-variable",
+                 "-Wl,--image-base=0x10000000", "-o", fx, r"src\gem_fauna.c", "-lkernel32"])
+    print("fx_test build: exit", rc, t.strip() or "")
+    ok &= rc == 0
+    for exe in exes:
+        rc, t = run([fx, exe])
+        print("--- %s: exit %d" % (exe, rc))
+        print(t.rstrip())
+        ok &= rc == 0
+
+    print("=== 3. head icon gate test")
+    cases = [("this source (0.12.2)", os.path.join(HERE, "src"), [])]
+    if old != "-":
+        cases.append(("old source " + old, os.path.join(old, "src"), ["-DEXPECT_0121"]))
+    for i, (what, inc, extra) in enumerate(cases):
+        exe = os.path.join(HERE, "out", "headicon_gate_test%d.exe" % i)
+        src_name = os.path.join(inc, "fx", "headicon.c").replace("\\", "/")
+        rc, t = run([zig, "cc", "-target", "x86_64-windows-gnu", "-O1", "-Wall", "-Wextra", "-Wno-unused-parameter",
+                     "-Wno-unused-function", "-I", inc, '-DFX_HEADICON_SRC="%s"' % src_name] + extra +
+                    ["-o", exe, r"tests\headicon_gate_test.c"])
+        print("--- build against", what, ": exit", rc, t.strip() or "")
+        ok &= rc == 0
+        rc, t = run([exe])
+        print(t.rstrip())
+        ok &= rc == 0
+    for f in os.listdir(os.path.join(HERE, "out")):
+        if f.endswith((".pdb", ".lib")) or f == "werror_check.dll":
+            os.remove(os.path.join(HERE, "out", f))
+    print("RESULT:", "ALL OK" if ok else "FAILED")
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/_dlls/_indomitus_DLL_fauna/tests/win/sys/mman.h b/_dlls/_indomitus_DLL_fauna/tests/win/sys/mman.h
new file mode 100644
index 0000000..e97e1dd
--- /dev/null
+++ b/_dlls/_indomitus_DLL_fauna/tests/win/sys/mman.h
@@ -0,0 +1,18 @@
+/* Windows stand-in for <sys/mman.h>, only what fx_test (FX_TEST build) uses: an anonymous mapping at a fixed address
+ * (the exe's image base). Lets tests/run_offline_check_win.py run the finder check on Windows with zig cc. */
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#define PROT_READ  1
+#define PROT_WRITE 2
+#define MAP_PRIVATE 2
+#define MAP_ANONYMOUS 0x20
+#define MAP_FIXED_NOREPLACE 0x100000
+#define MAP_FAILED ((void *)-1)
+__declspec(dllimport) void *__stdcall VirtualAlloc(void *addr, size_t size, unsigned long type, unsigned long protect);
+static void *mmap(void *addr, size_t len, int prot, int flags, int fd, long off)
+{
+    (void)prot; (void)flags; (void)fd; (void)off;
+    void *p = VirtualAlloc(addr, len, 0x3000 /* MEM_COMMIT | MEM_RESERVE */, 0x04 /* PAGE_READWRITE */);
+    return p ? p : MAP_FAILED;
+}
